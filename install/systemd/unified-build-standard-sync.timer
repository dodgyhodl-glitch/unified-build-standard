[Unit]
Description=Sync the Unified Build Standard every 12 hours and shortly after boot
Documentation=https://github.com/dodgyhodl-glitch/unified-build-standard

[Timer]
OnBootSec=5min
OnUnitActiveSec=12h
# Avoid every machine hitting GitHub on the same second.
RandomizedDelaySec=10min
Unit=unified-build-standard-sync.service

[Install]
WantedBy=timers.target
